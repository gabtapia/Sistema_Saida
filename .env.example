# ==============================================================================
# CONFIGURAÇÕES GERAIS DA APLICAÇÃO
# ==============================================================================
APP_NAME="Sistema de Controlo de Saídas IFPR"
APP_ENV="development"
DEBUG=True
PORT=8000
HOST="127.0.0.1"

# ==============================================================================
# BASE DE DADOS (SQLALCHEMY 2.0)
# ==============================================================================
# SQLite local (padrão)
DATABASE_URL="sqlite:///./saidas_ifpr.db"

# Exemplo para PostgreSQL:
# DATABASE_URL="postgresql+psycopg2://usuario:senha@localhost:5432/nome_banco"

# ==============================================================================
# SEGURANÇA E AUTENTICAÇÃO (JWT)
# ==============================================================================
# Gere uma chave segura no terminal com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY="sua_chave_secreta_aqui_substitua_por_uma_aleatoria"

# Algoritmo de assinatura JWT (HS256 padrão)
ALGORITHM="HS256"

# Tempo de validade do token de acesso em minutos (ex: 480 = 8 horas)
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ==============================================================================
# CONTROLO DE ACESSO HTTP (CORS)
# ==============================================================================
# Origens permitidas separadas por vírgula (URL onde o Streamlit está a rodar)
ALLOWED_ORIGINS="http://localhost:8501,http://127.0.0.1:8501"

# ==============================================================================
# UTILIZADOR ADMINISTRADOR INICIAL (SEED)
# ==============================================================================
# Credenciais criadas automaticamente no primeiro arranque se o banco estiver vazio
FIRST_SUPERUSER_NAME="Administrador Geral"
FIRST_SUPERUSER_EMAIL="admin@ifpr.edu.br"
FIRST_SUPERUSER_PASSWORD="coloque_uma_senha_forte_aqui"
